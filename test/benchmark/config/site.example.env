# Benchmark site configuration. Copy to test/benchmark/config/site.env (or ~/.config/rawmod/paths.env, or export the
# variables) and fill in the keys of the steps and tools you run. A key that is needed but not set is reported by the
# step that needs it; `python test/benchmark/rawmod_bench.py config` shows what is set. ${KEY} expands to setting KEY.

# --- data and outputs

# output root: one directory per sample, tables and figures (default test/work)
BENCH_WORK=

# where the downloaded datasets live (default test/data, where test/data/download_*.sh put them)
BENCH_DATA=

# optional: an existing sample sheet (sample, bam, pod5, ref) to use instead of building one
BENCH_SAMPLES=

# --- basecalling and alignment

# dorado 1.4.0 binary (basecalls with move tables, Dorado modification models)
DORADO=

# directory holding dna_r10.4.1_e8.2_400bps_sup@v5.0.0 and its modification models
DORADO_MODELS=

# dorado 0.9.2 bin/ directory with dna_r10.4.1_e8.2_400bps_hac@v4.2.0 inside (MethyNano only)
DORADO_092_DIR=

# samtools >= 1.16 (default: samtools on PATH)
SAMTOOLS=

# pod5 command-line tool, for read subsets (default: pod5 on PATH)
POD5=

# --- RawMod

# python of the environment RawMod is installed in (pip install -e .)
RAWMOD_PYTHON=

# RawHash2 checkout: test/scripts/refine_moves_remora.py and the R10.4.1 k-mer level table
RAWHASH2_DIR=

# python of an environment with ont-remora >= 3.3, pod5, pysam (the refinement step)
REFINE_PYTHON=

# --- baselines

# unimeth command (UniMeth v0.3.3)
UNIMETH=

# directory with the released unimeth_r10.4.1_5kHz_{5mC,6mA}.pt
UNIMETH_CHECKPOINTS=

# optional: UniMeth source with patches/unimeth-11215d4-finetune.patch applied (UniMeth-FT columns)
UNIMETH_FT_PYTHONPATH=

# optional: directory with the UniMeth-FT checkpoints {5hmC,4mC,5hmU}/final.pt (evaluation/train_unimeth_ft.sh)
UNIMETH_FT_CHECKPOINTS=

# DeepMod2 entry script (deepmod2), run with RAWMOD_PYTHON unless DEEPMOD2_PYTHON is set
DEEPMOD2=

# optional: python for DeepMod2
DEEPMOD2_PYTHON=

# rockfish command (r10.4.1 branch; needs FlashAttention, Ampere or newer GPU)
ROCKFISH=

# rf_5kHz.ckpt
ROCKFISH_MODEL=

# MethyNano checkout with patches/methynano-4f66a60-predict_aln.patch applied
METHYNANO_DIR=

# optional: python for MethyNano
METHYNANO_PYTHON=

# --- figures

# optional: folder of .ttf files for the figures (the paper used Times New Roman)
BENCH_FONTS=

# optional: a second folder the figures are also written to
BENCH_PAPER_FIGDIR=

# --- SLURM (rawmod_bench.py run --slurm)

# sbatch arguments for CPU steps, e.g. "--partition=cpu --mem=64G --time=06:00:00"
BENCH_SLURM_CPU=

# sbatch arguments for GPU steps, e.g. "--partition=gpu --gres=gpu:1 --mem=64G --time=08:00:00"
BENCH_SLURM_GPU=
