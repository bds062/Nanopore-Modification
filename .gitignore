# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# Generated data and model artifacts
data/
results/
logs/
*.h5
*.pt
*.pth
*.ckpt
*.npz
*.pod5
*.bam
*.bai
*.fast5

# Pretrained checkpoints are the exception: small (~1MB each), committed for
# reproducibility of the numbers in the README.
!checkpoints/
!checkpoints/**

# Plot/output scratch
*.out
*.log
.tmp_*/

# OS/editor
.DS_Store
*.swp

# Docs (background reading, not meant for the public repo) -- except the
# result figures referenced from the README
/docs/*
!/docs/figures/
!/docs/figures/**

# Superseded pipelines: kept locally for our own provenance/reference, out
# of scope for the public repo.
/archive/

# analysis/: only the evaluation-purpose scripts are tracked (diversity
# sweep, embedding diagnostics, pileup visualization). De novo motif
# discovery and one-off diagnostic plots stay local.
/analysis/*
!/analysis/chem_diversity_sweep/
!/analysis/chem_diversity_sweep/**
!/analysis/orca_remake/
!/analysis/orca_remake/**
!/analysis/visualize_h5_pileup.py
/analysis/**/__pycache__/

# wandb run dirs
wandb/
**/wandb/

# Local edit backups
*.bak
*.bak_*
*.pre_*

# Benchmark (test/): the benchmark definition in test/data is tracked; downloads, outputs and local site files are not
!/test/data/
/test/data/d[0-9]*_*/
/test/work/
/test/benchmark/config/site.env
/test/benchmark/config/site.*.env
!/test/benchmark/config/site.example.env
