# Site-specific locations used by the RawMod scripts. Copy to
# ~/.config/rawmod/paths.env (or point RAWMOD_PATHS_FILE at your copy) and fill in.
# Environment variables of the same name take precedence over this file.
# Only the variables a given script uses need to be set.
RAWMOD_REPO=/path/to/Nanopore-Modification
RAWMOD_RESULTS=/path/to/results
RAWMOD_DATA=/path/to/data
RAWMOD_STORE=/path/to/bulk_storage
RAWMOD_SHARED=/path/to/shared_data
RAWMOD_SCRATCH=/path/to/scratch
RAWMOD_LEGACY_RESULTS=/path/to/legacy_results
RAWMOD_LEGACY_DATA=/path/to/legacy_data
RAWMOD_TOOLS=/path/to/tools
RAWMOD_ENV=/path/to/conda/envs/rawmod
RAWMOD_ENVS=/path/to/conda/envs
CONDA_BASE=/path/to/miniconda3
CONDA_SH=/path/to/miniconda3/etc/profile.d/conda.sh
RAWHASH2_DIR=/path/to/RawHash2
# SLURM defaults (optional)
RAWMOD_SLURM_PARTITION=gpu
RAWMOD_SLURM_QOS=
RAWMOD_SBATCH_ARGS="--partition=gpu"
# Genome-map tools (optional; scripts/genome_map/submit.sh)
RAWMOD_DORADO=/path/to/dorado/bin/dorado
RAWMOD_DORADO_MODEL=/path/to/dna_r10.4.1_e8.2_400bps_sup@v5.0.0
RAWMOD_REFINE_ENV=remora
RAWMOD_SBATCH_CPU="--partition=<cpu_partition>"
RAWMOD_SBATCH_GPU="--partition=<gpu_partition> --gres=gpu:1"
