# Genome-map configuration. Copy, edit, then:
#   bash scripts/genome_map/submit.sh my_genome.env [--dry-run] [--from STEP]
# Defaults below are the paths on the UMD CBCB cluster used for the
# A. carterae contig_3762 5hmU map.

# ---- inputs ---------------------------------------------------------------
NAME=pao_3762                                   # prefix for output files
POD5=/path/to/pod5_dir                          # directory of .pod5 files (R10.4.1, 5 kHz)
REF=/path/to/genome.fasta                       # reference the reads are aligned to
OUT=/path/to/output_dir                         # everything is written under here
TARGET_BASE=T                                   # base carrying the mark on the read (T = 5hmU)
STRANDS="+"                                     # "+" or "+ -" (minus uses --orient read)
CONTIGS=""                                      # optional comma list; empty = whole reference
CHUNKS=24                                       # featurization array size

# ---- model ----------------------------------------------------------------
REPO=/fs/nexus-scratch/bds062/Nanopore-Modification
# Final model (BCE + SupCon + DeepSAD, bases visible). Use mixed for a new genome;
# use loco_<CHEM> only to ask "what would a model that never saw CHEM say".
CHECKPOINTS="mixed=$REPO/checkpoints/rawmod_final/mixed.pt"
# e.g. CHECKPOINTS="mixed=$REPO/checkpoints/rawmod_final/mixed.pt loco5hmU=$REPO/checkpoints/rawmod_final/loco_5hmU.pt"
PILEUP_MASK_BASES=0                             # 0 for rawmod_final; 1 only for masked (results72_B) models

# ---- featurization (match training; do not change without retraining) ----
MAX_READS=15
MIN_READS=10
MIN_MAPQ=20

# ---- external tools -------------------------------------------------------
PYTHON_ENV=/fs/nexus-scratch/bds062/envs/mod                 # conda env with rawmod deps
REFINE_ENV=campolina                                         # conda env with remora + samtools
CONDA_SH=/nfshomes/bds062/miniconda3/etc/profile.d/conda.sh
DORADO=/fs/cbcb-lab/storm/shared/rawhash2/basecallers/dorado-0.9.2-linux-x64/bin/dorado
DORADO_MODEL=/fs/cbcb-lab/storm/shared/rawhash2/basecallers/dorado-0.9.2-linux-x64/bin/dna_r10.4.1_e8.2_400bps_sup@v5.0.0
REFINE_PY=/fs/nexus-scratch/bds062/rawhash2-env/rawhash2-storm/test/scripts/refine_moves_remora.py
LEVELS=/fs/nexus-scratch/bds062/rawhash2-env/rawhash2-storm/extern/local_kmer_models/uncalled_r1041_model_only_means.txt
REFINE_SHARDS=16

# ---- SLURM ----------------------------------------------------------------
SBATCH_CPU="--partition=cbcb --account=cbcb --qos=high"
SBATCH_GPU="--partition=cbcb --account=cbcb --qos=high --gres=gpu:1"
